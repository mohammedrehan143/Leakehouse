# ==========================================
# RetailIQ Environment Configuration Template
# ==========================================

# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL=postgresql://retailiq:retailiq_secret@localhost:5432/retailiq_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=retailiq_db
POSTGRES_USER=retailiq
POSTGRES_PASSWORD=retailiq_secret

# Dataset Configuration
DATASET_PATH=data/raw/Online Retail.xlsx
DATA_DIRECTORY=data
DATASET_URL=https://archive.ics.uci.edu/static/public/352/online+retail.zip

# Logging & Telemetry
LOG_LEVEL=INFO

# AI Agent System (Optional for deterministic ETL)
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=your_llm_api_key_here
AGENT_MAX_RETRIES=3
AGENT_TIMEOUT_SECONDS=60
CHECKPOINT_DATABASE_URL=sqlite:///data/processed/checkpoints.db

# API & Dashboard
API_HOST=127.0.0.1
API_PORT=8000
DASHBOARD_PORT=8501
